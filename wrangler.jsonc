{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notepadaa",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notepadaa-db",
      "database_id": "GANTI_DENGAN_DATABASE_ID"
    }
  ]
}

